        <mxCell id="DDUVB4_bk2qrmLTNgyuY-66" parent="1" style="whiteSpace=wrap;html=1;rounded=0;align=left;" value="&lt;span style=&quot;font-size: x-small; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*El ZIP se puede descomrpimir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: x-small; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*Tiene insumo valido&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: x-small; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*Tiene solo un archivo txt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: x-small; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*Nomeclatura del archivo txt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: x-small; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*No existe el insumo txt con el mismo nombre cargado de forma previa&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*Cuenta con codificacion UTF-8 (RNA017)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;*Valida que el txt tenga un encabezado y el layout sea correcto (RNA012)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="220" x="-10" y="890" as="geometry" />
        </mxCell>
